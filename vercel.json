{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/powerbee-visionary-launch",
      "destination": "https://powerbee.tech/",
      "statusCode": 301
    },
    {
      "source": "/powerbee-visionary-launch/:path*",
      "destination": "https://powerbee.tech/",
      "statusCode": 301
    },
    {
      "source": "/polishengine-deck",
      "destination": "https://powerbee.tech/polishengine",
      "statusCode": 301
    },
    {
      "source": "/polishengine-deck/",
      "destination": "https://powerbee.tech/polishengine",
      "statusCode": 301
    },
    {
      "source": "/polishengine-deck/:path*",
      "destination": "https://powerbee.tech/polishengine",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/deck/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/polishengine/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/polishengine/pitch/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ]
}
